#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define FUNC    3
#define SYS     4

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        htb: hold_tap_balanced {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <170>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        bsht: back_space_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        lt_hp: layer-tap-hold-preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };

        copy_paste: copy_paste {
            compatible = "zmk,behavior-tap-dance";
            label = "COPY_PASTE";
            #binding-cells = <0>;
            bindings = <&kp LG(C)>, <&kp LG(V)>;

            tapping-term-ms = <300>;
        };
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_cmd_right {
            bindings = <&kp LGUI>;
            key-positions = <9 23>;
            timeout-ms = <60>;
        };

        combo_ctrl_right {
            bindings = <&kp LCTRL>;
            key-positions = <10 24>;
            timeout-ms = <60>;
        };

        combo_shift_right {
            bindings = <&kp LSHFT>;
            key-positions = <26 12>;
            timeout-ms = <60>;
        };

        combo_cmd_left {
            bindings = <&kp LGUI>;
            key-positions = <4 18>;
            timeout-ms = <60>;
            layers = <0 1 2>;
        };

        combo_ctrl_left {
            bindings = <&kp LCTRL>;
            key-positions = <3 17>;
            timeout-ms = <60>;
        };

        combo_shift_left {
            bindings = <&kp LSHFT>;
            key-positions = <15 1>;
            timeout-ms = <60>;
        };

        combo_alt_left {
            bindings = <&kp LALT>;
            key-positions = <2 16>;
        };

        combo_opt_right {
            bindings = <&kp LALT>;
            key-positions = <11 25>;
        };

        hyper_left {
            bindings = <&kp LS(LA(LC(LGUI)))>;
            key-positions = <4 3>;
        };

        hyper_right {
            bindings = <&kp LS(LA(LC(LGUI)))>;
            key-positions = <9 10>;
        };

        meh_left {
            bindings = <&kp LS(LC(LALT))>;
            key-positions = <41 42>;
        };

        meh_right {
            bindings = <&kp LS(LA(LCTRL))>;
            key-positions = <43 44>;
        };

        combo_alt_ctrl_left {
            bindings = <&kp LC(LALT)>;
            key-positions = <19 18>;
            timeout-ms = <60>;
            layers = <0 1 2>;
        };

        combo_alt_ctrl_shft_left {
            bindings = <&kp LC(LS(LALT))>;
            key-positions = <18 32>;
            timeout-ms = <60>;
            layers = <0 1 2>;
        };

        tmux_leader_left {
            bindings = <&kp LC(SPACE)>;
            key-positions = <18 17>;
        };

        tmux_leader_right {
            bindings = <&kp LC(SPACE)>;
            key-positions = <23 24>;
        };

        sys_layer {
            bindings = <&mo 4>;
            key-positions = <7 21>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "MAIN";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | CTRL| LGUI| SPC |               | ENT | RSE  | DEL |

            bindings = <
&ht LGUI ESC  &kp Q  &kp W  &kp F      &kp P     &kp B               &kp C_MUTE  &kp C_PP  &kp J             &kp L     &kp U         &kp Y    &kp SEMI  &key_repeat
&ht LALT TAB  &kp A  &kp R  &kp S      &kp T     &kp G               &kp LALT    &kp RALT  &kp M             &kp N     &kp E         &kp I    &kp O     &kp SQT
&kp LSHFT     &kp Z  &kp X  &kp C      &kp D     &kp V                                     &kp K             &kp H     &kp COMMA     &kp DOT  &kp FSLH  &kp RSHIFT
                            &kp LCTRL  &kp LGUI  &lt_hp RAISE SPACE                        &lt_hp LOWER RET  &kp BSPC  &lt_hp 5 DEL
            >;
        };

        lower_layer {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |      |
            //                    |     |     |       |        |       |     |     |

            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp LCTRL  &kp RCTRL  &kp N6                     &kp N7    &kp N8    &kp N9  &kp N0     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LALT   &kp RALT   &kp LS(LA(LC(LG(RIGHT))))  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans                        &kp LS(LA(LC(LG(LEFT))))   &trans    &trans    &trans  &trans     &trans
                        &trans  &trans  &trans                        &trans                     &trans    &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL | HUD | HUI |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp LCTRL  &kp RCTRL  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &trans
&trans  &trans    &trans  &trans    &trans    &trans     &kp LALT   &kp RALT   &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &trans    &trans  &trans    &trans    &trans                           &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                          &trans    &trans    &trans                           &trans     &trans     &trans
            >;
        };

        func_layer {
            display-name = "FUNC";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL | HUD | HUI |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans  &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F11  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &kp F12  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        system_layer {
            display-name = "SYSTEM";
            bindings = <
&bootloader     &trans           &trans           &trans           &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&studio_unlock  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR      &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG  &trans        &trans                        &trans  &trans  &trans  &trans  &trans  &trans
                                                  &trans           &trans        &trans                        &trans  &trans  &trans
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_UP    &mkp LCLK       &mkp RCLK        &mkp MCLK     &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans          &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans        &trans           &trans
                        &trans  &trans  &trans                  &trans          &trans          &trans
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
